# Browser-facing paths. These VITE_* values are public build-time configuration;
# keep them relative when the SPA is served by amuleapi and never put secrets here.
VITE_API_BASE=/api/v0
VITE_EVENTS_URL=/api/v0/events

# Vite development-server proxy target. This is not used by the production bundle.
VITE_DEV_API_ORIGIN=http://127.0.0.1:4713
