# Copy to docker.env, choose host ports/ownership, and use it with
# `docker compose --env-file docker.env up -d --build`.
PUID=1000
PGID=1000
AMULE_UI_PORT=4713
AMULE_TCP_PORT=4662
AMULE_UDP_PORT=4672
# Use a Docker Hub repository (for example, alvarogl/amule-console) when
# deploying a published image. Keep the local default when building from source.
AMULE_IMAGE=amule-console
AMULE_IMAGE_VERSION=local
# This file is a Docker secret source, not an environment value.
AMULE_ADMIN_PASSWORD_FILE=./secrets/amule-admin-password
